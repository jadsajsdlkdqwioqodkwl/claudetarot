{
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    }
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "claude-mem@thedotmack": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__codegraph__*",
      "mcp__memory__*",
      "mcp__Google_Sheets__*",
      "mcp__Google_Docs__*",
      "mcp__Google_Drive__*",
      "mcp__claude-code-remote__*",
      "mcp__FIRECRAWL__*",
      "mcp__META__*",
      "mcp__github__*",
      "Bash",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch",
      "Bash(python3 scripts/asesor/enviar.py:*)",
      "Bash(python3 scripts/asesor/boletas.py:*)",
      "Bash(python3 scripts/asesor/reporte.py:*)",
      "Bash(python3 scripts/asesor/dinsides.py:*)",
      "Bash(python3 scripts/asesor/etiquetas.py:*)",
      "Bash(python3 scripts/asesor/shalom.py:*)",
      "Bash(python3 scripts/asesor/preparar.py:*)",
      "Bash(python3 scripts/asesor/contexto.py:*)",
      "Bash(python3 scripts/asesor/memoria.py:*)"
    ]
  }
}
