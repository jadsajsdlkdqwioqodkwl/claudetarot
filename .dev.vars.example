# Copia este archivo a `.dev.vars` y completa los valores reales.
# `.dev.vars` está en .gitignore: nunca se sube al repositorio.
#
# En producción las variables de texto salen de wrangler.jsonc y los dos
# secretos se cargan con `npx wrangler secret put <NOMBRE>`.

GOOGLE_SHEET_ID="1kcoEEG6E2uHFLQ_wjjq6oVMQg4bzvIqmPYygiBT6qQc"
GOOGLE_SHEET_NAME="Pedidos"
GOOGLE_CLIENT_EMAIL="crm-sheets-bot-2@tarot-product-page.iam.gserviceaccount.com"

# El private_key del JSON de la service account, completo y en una sola línea,
# con los \n literales tal como vienen en el archivo.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Aviso de pedidos nuevos por Telegram (opcional en local: sin esto, /api/order
# sigue guardando el pedido igual, solo no manda el aviso).
TELEGRAM_BOT_TOKEN="123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TELEGRAM_CHAT_ID="123456789"

# Pestaña del CRM manual de ventas (la del seguimiento de provincia).
GOOGLE_VENTAS_NAME="Ventas"

# Landing de Conde School (public/temario-diplomado.html): crea/actualiza el
# contacto en GHL con un tag, para retargeting. GHL_API_KEY es un Private
# Integration Token (Configuración → Integraciones → Private Integrations),
# con el scope de contactos. GHL_LOCATION_ID sale de la URL del panel de esa
# location. En producción GHL_API_KEY va como secret:
#   npx wrangler secret put GHL_API_KEY
GHL_API_KEY="pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
GHL_LOCATION_ID="REEMPLAZA_CON_TU_LOCATION_ID"
GHL_LEAD_TAG="lead-diplomado-importacion"

# Token del diagnóstico compartido por /api/diag y /api/temario-diag.
DIAG_TOKEN="elige-un-token-largo-y-al-azar"
