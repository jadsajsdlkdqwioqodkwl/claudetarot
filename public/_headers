/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob: https://www.facebook.com https://*.fbcdn.net; media-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob: https://connect.facebook.net https://unpkg.com; worker-src 'self' blob:; connect-src 'self' blob: https://www.facebook.com https://connect.facebook.net https://unpkg.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'

/api/*
  Cache-Control: no-store

# El CRM es privado: nunca cachear y fuera de índices de buscadores.
/crm/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# Las imagenes y el video no cambian de contenido sin cambiar de nombre, asi que
# el navegador puede guardarlos un ano y no volver a pedirlos nunca.
/kittarotcod/*
  Cache-Control: public, max-age=31536000, immutable

# El HTML si cambia con cada despliegue: se revalida siempre para que nadie se
# quede con una version vieja de la pagina o de los precios.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/gracias
  Cache-Control: public, max-age=0, must-revalidate

# La página de seguimiento se sirve bajo /TS-XXXXXXX, no bajo su nombre de
# archivo, así que esta regla la aplica el Worker al reenviarla (ver
# paginaDeSeguimiento en src/index.js). Aquí queda por si alguien la abre
# directo: sin datos dentro, es solo el cascarón.
/seguimiento.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex, nofollow

# Landing del Cable con Soporte 2 en 1 (/cable/). El HTML se revalida siempre;
# fotos y videos no cambian de contenido sin cambiar de nombre. Las reglas no se
# solapan a propósito: Cloudflare junta los encabezados de todas las que coinciden.
/cable/
  Cache-Control: public, max-age=0, must-revalidate
/cable/index.html
  Cache-Control: public, max-age=0, must-revalidate
/cable/gracias
  Cache-Control: public, max-age=0, must-revalidate
/cable/gracias.html
  Cache-Control: public, max-age=0, must-revalidate
/cable/img/*
  Cache-Control: public, max-age=31536000, immutable
/cable/video/*
  Cache-Control: public, max-age=31536000, immutable

# Landing de la Masilla Selladora (/masilla/): mismas reglas que /cable/ (sin solapes).
/masilla/
  Cache-Control: public, max-age=0, must-revalidate
/masilla/index.html
  Cache-Control: public, max-age=0, must-revalidate
/masilla/gracias
  Cache-Control: public, max-age=0, must-revalidate
/masilla/gracias.html
  Cache-Control: public, max-age=0, must-revalidate
/masilla/img/*
  Cache-Control: public, max-age=31536000, immutable
/masilla/video/*
  Cache-Control: public, max-age=31536000, immutable
