{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claudetarot",
  // Cuenta de Cloudflare: la necesita wrangler con un token de cuenta (CLOUDFLARE_API_TOKEN del entorno de Claude Code).
  "account_id": "d0c6550b43c7a966eb8e93a69a653993",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",

  // La página vive en public/. Cloudflare la sirve directamente y solo
  // invoca al Worker cuando la ruta no existe como archivo (o sea, /api/*).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // Workers AI: solo para transcribir audios del CRM (Whisper). No es la API de Claude.
  "ai": { "binding": "AI" },

  "observability": {
    "enabled": true
  },

  // Crons con trabajos distintos (se distinguen por `event.cron` en
  // src/index.js): el de cada minuto manda el WhatsApp de los pedidos web a
  // los 3 min y, en los minutos múltiplos de 5, los seguimientos vencidos; el
  // de cada 10 minutos vuelca los mensajes nuevos del CRM a Google Sheets.
  "triggers": {
    "crons": ["* * * * *", "*/10 * * * *", "*/15 * * * *"]
  },

  // Base del CRM: contactos, conversaciones y mensajes de WhatsApp.
  "d1_databases": [
    {
      "binding": "CRM_DB",
      "database_name": "claudetarot-crm",
      "database_id": "3b5ef8ee-aac0-4550-826b-f37f9a2f3360"
    }
  ],

  // Archivos del CRM: fotos/video que manda el cliente (se cachean acá la
  // primera vez que se piden) y los que sube el vendedor para mandar o
  // guardar en una respuesta rápida.
  "r2_buckets": [
    {
      "binding": "CRM_MEDIA",
      "bucket_name": "claudetarot-crm-media"
    }
  ],

  /**
   * Tope de pedidos por IP: 5 por minuto. Frena el spam sin estorbar a un
   * cliente real, y deja probar el formulario varias veces seguidas.
   * No necesita crear nada: el namespace_id es local a este Worker.
   */
  "ratelimits": [
    {
      "name": "ORDER_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },

    /**
     * Consultas a la página de seguimiento: 40 por minuto y por IP. Va aparte
     * de ORDER_LIMIT porque son cosas distintas: 5 pedidos por minuto es
     * sospechoso, pero recargar el seguimiento de tu propio envío varias veces
     * seguidas es lo normal. Compartiendo el tope, un cliente impaciente se
     * quedaba sin poder pedir.
     */
    {
      "name": "TRACK_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 40, "period": 60 }
    },

    /**
     * Login del CRM: 10 intentos por minuto y por IP, contra fuerza bruta de
     * la contraseña o del código de 6 dígitos.
     */
    {
      "name": "LOGIN_LIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  /**
   * Variables en texto plano. ESTE archivo manda: cada despliegue reemplaza
   * las variables de texto del dashboard por las de aquí, así que edítalas
   * acá y no en la consola de Cloudflare.
   *
   * Los SECRETOS no van aquí (se subirían a GitHub). Van por dashboard o CLI
   * y sobreviven a los despliegues:
   *   GOOGLE_PRIVATE_KEY    npx wrangler secret put GOOGLE_PRIVATE_KEY
   *   TELEGRAM_BOT_TOKEN    npx wrangler secret put TELEGRAM_BOT_TOKEN
   *
   * TELEGRAM_CHAT_ID va aquí y no en el dashboard justamente por lo de arriba:
   * como texto plano en la consola, el siguiente despliegue lo borraba y el
   * aviso de Telegram dejaba de salir sin que nadie se enterara. Solo el id de
   * un chat, sin el token del bot, no sirve para nada.
   */
  "vars": {
    "GOOGLE_SHEET_ID": "1kcoEEG6E2uHFLQ_wjjq6oVMQg4bzvIqmPYygiBT6qQc",
    "GOOGLE_SHEET_NAME": "Pedidos",
    // Landing del Cable (/cable/): sus pedidos caen en la pestaña "Cable" de este mismo libro, que se crea sola.
    // Para mandarlos a OTRO libro (compartido como Editor con GOOGLE_CLIENT_EMAIL) o con otro nombre de pestaña,
    // agregar aquí GOOGLE_CABLE_SHEET_ID y/o GOOGLE_CABLE_SHEET_NAME. Ver docs/cable.md.
    // Landing de la Masilla (/masilla/): pestaña "Masilla" del mismo libro (se crea sola); GOOGLE_MASILLA_SHEET_ID / GOOGLE_MASILLA_SHEET_NAME la cambian. Ver docs/masilla.md.
    // La pestaña del CRM manual de ventas, la que alimenta el seguimiento.
    // Es otra pestaña del MISMO libro: un solo GOOGLE_SHEET_ID para las dos.
    "GOOGLE_VENTAS_NAME": "Ventas",
    "GOOGLE_CLIENT_EMAIL": "crm-sheets-bot-2@tarot-product-page.iam.gserviceaccount.com",
    "TELEGRAM_CHAT_ID": "8780926886",

    // CRM de WhatsApp — el ID del número de teléfono de la Cloud API (texto,
    // no es secreto). Los secretos van por dashboard/CLI, ver README.
    "WHATSAPP_PHONE_NUMBER_ID": "1395872996931928",
    // Número personal del dueño (formato internacional sin +) desde el que manda
    // fotos de boletas al número empresa. El webhook lo intercepta antes del CRM.
    "NUMERO_DUENO": "51927633099",
    // Para listar y mandar Message Templates (mensajes fuera de la ventana
    // de 24h) desde /api/crm/templates.
    "WHATSAPP_BUSINESS_ACCOUNT_ID": "1685975599621194",

    // Hoja donde el cron vuelca los chats crudos cada 10 min, para que un
    // LLM los procese después. Usa la MISMA cuenta de servicio de arriba —
    // solo hay que compartirle esta hoja como Editor.
    "GOOGLE_CRM_SHEET_ID": "1ksEBDIQg8DEH8px5tTYzGZbR46bYSaCikXYA9czLVys",
    "GOOGLE_CRM_SHEET_NAME": "Sheet1",

    // El catálogo REALMENTE conectado a este número ("API Catálogo Tarots"),
    // confirmado con /api/diag → "catálogo conectado a WhatsApp". El de
    // Commerce Manager (785861823961723) existe pero no está enlazado al
    // número, por eso mandar un producto individual daba (#131009).
    "WHATSAPP_CATALOG_ID": "1610775203147241",

    // Carrito abandonado (src/lib/crm-carrito.js): horas de silencio del
    // cliente después de que la vendedora le pidió la ubicación (Lima) o el
    // adelanto (provincia), antes de mandarle UN recordatorio, siempre dentro
    // de la ventana de 24 h. Sin IA. Vacío = apagado. Entre 1 y 20.
    // CARRITO_MENSAJE_LIMA / CARRITO_MENSAJE_PROVINCIA (opcionales) cambian
    // el texto; {nombre} = su primer nombre.
    "CARRITO_AUTO_HORAS": "",
    // Plantilla utility que se usaba para el link de seguimiento ({{1}}=nombre, {{2}}=link).
    // Deprecada 2026-10-28: conPlantilla ahora usa aviso_envio_shalom directamente (solo {{1}}=nombre).
    // Se deja vacía para no romper código que pueda leerla, pero ya no la consume conPlantilla.
    "PLANTILLA_ENVIO": "",
    // Plantilla "recibimos su pedido" + botón CONFIRMA TU PEDIDO (la armó el
    // dueño en WhatsApp Manager, Spanish PER) que le sale al cliente de la web a
    // los 3 min si no nos escribió antes (src/lib/pedidos-web.js). Vacío = apagado.
    "PLANTILLA_PEDIDO_WEB": "pedido_web_recibido",
    // Usuarios (username) que además del admin ven "Links de Shalom" en el CRM.
    "SHALOM_AGENTES": "danitza",
    // Usuarios (username) que además del dueño reciben por Telegram el PDF de
    // pedidos con su link (tienen que haber vinculado Telegram en el CRM).
    "REPORTE_AGENTES": "danitza",
    // Claves de recojo de Shalom que se reparten entre los pedidos (una por pedido).
    "CLAVES_SHALOM": "3114,3144,3143",
    // Horario en que salen los mensajes programados (hora de Lima). Fuera de
    // él se reprograman: a las 06:00 si la ventana de 24 h sigue abierta, si
    // no a las 23:29, y si ya no se puede se cancelan (ver src/lib/horario.js).
    "HORARIO_ENVIO": "06:00-23:30",
    // Toques con plantilla (src/lib/toques.js): Tarot Store (d2…post60) y URO (u_…). No sale nada hasta que
    // el admin mande las plantillas a Meta desde el CRM y Meta las apruebe. Requiere la migración 0043.
    "TOQUES": "d2,d7,d14,d30,post7,post14,post30,post60,u_d2,u_d7,u_d14,u_d30,u_post7,u_post25",
    "TOQUES_MAX_DIA": "40",

    // SHA-256 de la clave con la que la Routine del asesor llama a
    // /api/asesor/avisos (src/api/asesor.js). La clave en sí vive solo en el
    // prompt de la Routine; aquí va el hash, que no sirve para nada sin ella.
    "ASESOR_CLAVE_SHA256": "b22840bc68a039ffe4a74253fb8cb83f5092dc99b830bb4b931d95c249ad4c6a,07fa0300e12de853dada6ab803ade565c758674bb096a141efc4a836d1c8f153,571f8b56eb5ef944e944ecfa7a8f722560b280fe17d9653253aa0eb4e8792df2"
  }
}
