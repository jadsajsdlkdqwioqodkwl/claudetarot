{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claudetarot",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",

  // La página vive en public/. Cloudflare la sirve directamente y solo
  // invoca al Worker cuando la ruta no existe como archivo (o sea, /api/*).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  /**
   * Tope de pedidos por IP: 5 por minuto. Frena el spam sin estorbar a un
   * cliente real, y deja probar el formulario varias veces seguidas.
   * No necesita crear nada: el namespace_id es local a este Worker.
   */
  "ratelimits": [
    {
      "name": "ORDER_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },

    /**
     * Consultas a la página de seguimiento: 40 por minuto y por IP. Va aparte
     * de ORDER_LIMIT porque son cosas distintas: 5 pedidos por minuto es
     * sospechoso, pero recargar el seguimiento de tu propio envío varias veces
     * seguidas es lo normal. Compartiendo el tope, un cliente impaciente se
     * quedaba sin poder pedir.
     */
    {
      "name": "TRACK_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 40, "period": 60 }
    },

    /**
     * Formulario de public/temario-diplomado.html: nombre + WhatsApp, sin
     * fricción, así que 8 por minuto por IP deja probar varias veces
     * seguidas sin abrirle la puerta a un bot.
     */
    {
      "name": "TEMARIO_LEAD_LIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 8, "period": 60 }
    }
  ],

  /**
   * Variables en texto plano. ESTE archivo manda: cada despliegue reemplaza
   * las variables de texto del dashboard por las de aquí, así que edítalas
   * acá y no en la consola de Cloudflare.
   *
   * Los SECRETOS no van aquí (se subirían a GitHub). Van por dashboard o CLI
   * y sobreviven a los despliegues:
   *   GOOGLE_PRIVATE_KEY    npx wrangler secret put GOOGLE_PRIVATE_KEY
   *   TELEGRAM_BOT_TOKEN    npx wrangler secret put TELEGRAM_BOT_TOKEN
   *
   * TELEGRAM_CHAT_ID va aquí y no en el dashboard justamente por lo de arriba:
   * como texto plano en la consola, el siguiente despliegue lo borraba y el
   * aviso de Telegram dejaba de salir sin que nadie se enterara. Solo el id de
   * un chat, sin el token del bot, no sirve para nada.
   */
  "vars": {
    "GOOGLE_SHEET_ID": "1kcoEEG6E2uHFLQ_wjjq6oVMQg4bzvIqmPYygiBT6qQc",
    "GOOGLE_SHEET_NAME": "Pedidos",
    // La pestaña del CRM manual de ventas, la que alimenta el seguimiento.
    // Es otra pestaña del MISMO libro: un solo GOOGLE_SHEET_ID para las dos.
    "GOOGLE_VENTAS_NAME": "Ventas",
    "GOOGLE_CLIENT_EMAIL": "crm-sheets-bot-2@tarot-product-page.iam.gserviceaccount.com",
    "TELEGRAM_CHAT_ID": "8780926886",

    // Landing de Conde School (public/temario-diplomado.html). El
    // GHL_API_KEY (Private Integration Token) va como secret, nunca aquí:
    //   npx wrangler secret put GHL_API_KEY
    "GHL_LOCATION_ID": "REEMPLAZA_CON_TU_LOCATION_ID",
    "GHL_LEAD_TAG": "lead-diplomado-importacion"
  }
}
